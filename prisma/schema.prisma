generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum ProjectStatus {
  completed
  ongoing
  planned
}

enum ProjectCategory {
  residential
  commercial
  industrial
  infrastructure
  institutional
  renovation
}

enum InquiryStatus {
  new
  in_progress
  quoted
  won
  lost
  archived
}

enum ContentStatus {
  draft
  published
  archived
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  emailVerified Boolean    @default(false)
  status        UserStatus @default(PENDING)
  role          String     @default("VIEWER")
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions      Session[]
  accounts      Account[]
  assignedInquiries Inquiry[] @relation("AssignedInquiries")
  inquiryNotes  InquiryNote[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Project {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  location        String
  category        ProjectCategory
  status          ProjectStatus   @default(planned)
  completionDate  String?
  summary         String
  description     String          @db.Text
  scope           String[]
  coverImage      String
  gallery         String[]
  client          String?
  featured        Boolean         @default(false)
  seoTitle        String?
  seoDescription  String?
  published       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  testimonials    Testimonial[]

  @@index([published, featured])
  @@index([category])
  @@index([status])
  @@index([slug])
}

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  category         String
  shortDescription String
  description      String   @db.Text
  scope            String[]
  approach         String[]
  image            String
  published        Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([slug])
}

model TeamMember {
  id             String   @id @default(cuid())
  name           String
  role           String
  bio            String   @db.Text
  photo          String
  qualifications String[]
  sortOrder      Int      @default(0)
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([published, sortOrder])
}

model Article {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  category       String
  excerpt        String
  content        String        @db.Text
  coverImage     String
  author         String
  publishedAt    DateTime?
  status         ContentStatus @default(draft)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
}

model Inquiry {
  id          String        @id @default(cuid())
  reference   String        @unique
  name        String
  email       String
  phone       String?
  company     String?
  serviceType String?
  projectType String?
  location    String?
  message     String        @db.Text
  status      InquiryStatus @default(new)
  assignedToId String?
  source      String        @default("contact")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  assignedTo  User?         @relation("AssignedInquiries", fields: [assignedToId], references: [id])
  notes       InquiryNote[]

  @@index([status, createdAt])
  @@index([reference])
  @@index([assignedToId])
}

model InquiryNote {
  id        String   @id @default(cuid())
  inquiryId String
  text      String   @db.Text
  authorId  String?
  authorName String
  createdAt DateTime @default(now())

  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id])

  @@index([inquiryId])
}

model QuoteRequest {
  id          String   @id @default(cuid())
  reference   String   @unique
  name        String
  email       String
  phone       String
  company     String?
  projectType String
  location    String
  scope       String   @db.Text
  budget      String?
  timeline    String?
  status      InquiryStatus @default(new)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@index([reference])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  company   String?
  quote     String   @db.Text
  projectId String?
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project? @relation(fields: [projectId], references: [id])

  @@index([published, sortOrder])
}

model SiteSetting {
  id                   String   @id @default("default")
  companyName          String
  tagline              String
  description          String   @db.Text
  address              String
  phone                String
  email                String
  whatsapp             String?
  officeHours          String
  linkedin             String?
  facebook             String?
  instagram            String?
  twitter              String?
  registrationDetails  String?
  updatedAt            DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  outcome    String   @default("success")
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([resource, createdAt])
  @@index([actorId])
}
